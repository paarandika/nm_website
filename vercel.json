{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/team.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nosnippet, noarchive, noimageindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
