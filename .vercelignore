# NOTE: this excludes files from the source upload, which is also the build environment.
# Anything the build itself needs must NOT be listed here. tools/ in particular holds
# prerender.js, which is what `npm run build` runs - excluding it breaks the deploy.
#
# What actually reaches the public is dist/ (vercel.json outputDirectory), so source
# files are not served regardless of what is listed below.

